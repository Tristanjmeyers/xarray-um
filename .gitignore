# pixi environments
.pixi/*
!.pixi/config.toml

# Rust/Python build outputs
/target/
/dist/
__pycache__/
.pytest_cache/
*.pyc
*.so

.ipynb_checkpoints/
*.writing
# Local milestone/benchmark runners contain site-specific paths.
/scripts/*
!/scripts/check_artifacts.py
!/scripts/check_wheel.py
/notebooks/

# Portable validation and benchmark tools
!/scripts/compare_converters.py
!/scripts/comparison_notebook.py
!/scripts/benchmark_scaling.py
!/scripts/publish_results.py
